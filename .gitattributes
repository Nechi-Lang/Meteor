# ----------------------------------------------------------------------
# 1. Global Defaults
# ----------------------------------------------------------------------
# Automatically normalize line endings to LF in the repository
* text=auto

# ----------------------------------------------------------------------
# 2. C++ Source and Header Files
# ----------------------------------------------------------------------
# Force LF line endings for all C++ code files on checkout
*.cpp   text eol=lf
*.hpp   text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cc    text eol=lf
*.cxx   text eol=lf
*.h++   text eol=lf
*.hh    text eol=lf
*.inl   text eol=lf
*.tpp   text eol=lf

# ----------------------------------------------------------------------
# 3. Build & Project Configuration Files
# ----------------------------------------------------------------------
# Ensure build scripts use LF (crucial for Linux/macOS execution)
*.sh    text eol=lf
Makefile text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# MSVC / Windows specific project files (often require CRLF)
*.sln   text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf

# ----------------------------------------------------------------------
# 4. Documentation and Data
# ----------------------------------------------------------------------
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# ----------------------------------------------------------------------
# 5. Binary Files (Do not treat as text / Do not normalize)
# ----------------------------------------------------------------------
# Compiled object files and libraries
*.o     binary
*.obj   binary
*.a     binary
*.lib   binary
*.so    binary
*.dylib binary
*.dll   binary

# Executables
*.exe   binary
*.out   binary

# Precompiled headers
*.gch   binary
*.pch   binary

# Pre-built assets / Images
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
